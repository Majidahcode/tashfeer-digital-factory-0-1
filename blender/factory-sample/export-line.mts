/**
 * Writes the production line's path, as the factory's code defines it (layout.ts), for the Blender build: samples
 * along the line with their arc length, position and the across direction (the camera side). The belt built in
 * Blender then lies exactly where the stations and the product expect it.
 *   node --experimental-strip-types blender/factory-sample/export-line.mts
 */
import { writeFileSync } from "node:fs";
import {
  CURVE,
  ENTRY_U,
  LANES,
  SAMPLE,
  TRACK,
  frameAt,
  productPlace,
  stationPlace,
} from "../../src/components/factory/scene/layout.ts";

function place(pos: { x: number; y: number; z: number }, n: { x: number; z: number }) {
  return { x: pos.x, y: pos.y, z: pos.z, yaw: Math.atan2(n.x, n.z) };
}

const N = 480;
const length = CURVE.getLength();
const samples = [];
for (let i = 0; i <= N; i++) {
  const u = i / N;
  const { p, n } = frameAt(u);
  samples.push({ s: +(u * length).toFixed(5), x: +p.x.toFixed(5), z: +p.z.toFixed(5), nx: +n.x.toFixed(6), nz: +n.z.toFixed(6) });
}
writeFileSync(
  new URL("./line.json", import.meta.url),
  JSON.stringify({
    note: "generated by export-line.mts from layout.ts — three.js axes (y up); yaw turns a model's front (+z) to the camera side",
    length,
    track: TRACK,
    lanes: LANES,
    // where the sample's pieces stand in the reference shot: station 01, and the product waiting at the entry
    station01: place(stationPlace(0).pos, stationPlace(0).n),
    productEntry: place(productPlace(ENTRY_U).pos, productPlace(ENTRY_U).n),
    camera: { pos: SAMPLE.pos.toArray(), target: SAMPLE.target.toArray(), fovVertical: SAMPLE.fov },
    samples,
  }),
);
console.log(`line.json: ${samples.length} samples, ${length.toFixed(2)} m`);
